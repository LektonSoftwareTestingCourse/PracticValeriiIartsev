{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["mti", "stan", "rrn", "authCode", "responseCode", "status", "declineReason", "processingTimeMs"],
  "properties": {
    "mti": {"type": "string", "pattern": "^[0-9]{4}$"},
    "stan": {"type": "string", "pattern": "^[0-9]{6}$"},
    "rrn": {"type": ["string", "null"], "pattern": "^[0-9]{12}$"},
    "authCode": {"type": ["string", "null"], "pattern": "^[A-Z0-9]{6}$"},
    "responseCode": {"type": "string", "pattern": "^[0-9]{2}$"},
    "status": {"enum": ["APPROVED", "DECLINED"]},
    "declineReason": {"type": ["string", "null"]},
    "processingTimeMs": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
